# Copy to .env and adjust. Never commit your .env.

# paper = simulate (no money), live = real orders
MODE=paper

# --- strategy (defaults = HighTempTation) ---
MAX_BUY_PRICE=0.98
SELL_PRICE=0.99
MIN_EDGE=0.005
# 0 = exactly like him. 1 = only buy when the reading is a full degree past the bucket (safer, fewer trades)
SAFETY_MARGIN=0
ENABLE_YES_BETS=true
SELL_DELAY_SECONDS=5

# --- small-scale limits (USDC) ---
MAX_USDC_PER_TRADE=10
MAX_USDC_PER_MARKET=20
MAX_OPEN_USDC=50
DAILY_LOSS_LIMIT=20

# --- data ---
# aviationweather (one request for all stations) or tgftp (NOAA per-station files, often a bit faster)
METAR_SOURCE=aviationweather
POLL_SECONDS=10
# leave empty for all cities, or e.g.: CITIES=London,Paris,NYC
CITIES=

# --- live only ---
# Private key of your Polymarket account (Settings -> Export private key)
PRIVATE_KEY=
# Your Polymarket wallet address (the 0x... address on your profile)
FUNDER=
# 1 = email/Magic login, 2 = browser wallet (MetaMask etc.)
SIGNATURE_TYPE=1
