# Copy to .env and adjust. Never commit your .env.

# paper = simulate (no money), live = real orders
MODE=paper

# --- strategy (defaults = HighTempTation) ---
# 0.975-0.98 earned him only +1.4% per trade and one wrong reading costs 100%; 0.98 is the hard maximum
MAX_BUY_PRICE=0.975
SELL_PRICE=0.99
MIN_EDGE=0.005
# 0 = exactly like him. 1 = only buy when the reading is a full degree past the bucket (safer, fewer trades)
SAFETY_MARGIN=0
ENABLE_YES_BETS=true
SELL_DELAY_SECONDS=5

# --- money: the bot grows its bets with its balance (compounding) ---
# Start amount (only used the very first time; after that the saved balance in state.json counts)
START_AMOUNT=100
# All % are of the CURRENT equity (balance with open positions at their current value).
# Max per buy: a wrong reading loses ~100% of the buy, and at 5% a 30% drawdown is ~0.1% likely (13% at 10%)
TRADE_PCT=5
# Max per bucket per day: one buy plus one quick rebuy (his rebuys were ~3% of his money)
MARKET_PCT=8
# Max in one market (event) in positions not yet sold at 0.99: one bad reading often hits 2-3 buckets
EVENT_PCT=10
# Max in open positions at once: he never had more than 3-4 new buys within a minute
OPEN_PCT=30
# Stop buying for the rest of the day after losing this % of the day's starting equity (one wrong bucket + a bit)
DAILY_LOSS_PCT=6
# Stop buying (until you press Start again) after falling this % below the highest equity so far
MAX_DRAWDOWN_PCT=15
# Dollar caps per buy and per market: positions of $1,000+ lost more than half 10x as often; raise only
# after 2 clean live weeks
MAX_TRADE_USDC=250
MAX_EVENT_USDC=500

# --- data ---
# aviationweather (one request for all stations) or tgftp (NOAA per-station files, often a bit faster)
METAR_SOURCE=aviationweather
POLL_SECONDS=10
# leave empty for all cities, or e.g.: CITIES=London,Paris,NYC
CITIES=

# --- live only ---
# Live trading is refused where Polymarket blocks it, and always from these countries (comma-separated).
# Getting around the block (for example with a VPN) breaks Polymarket's terms: account and funds at risk.
HARD_BLOCK_COUNTRIES=NL
# Private key of your Polymarket account (Settings -> Export private key)
PRIVATE_KEY=
# Your Polymarket wallet address (the 0x... address on your profile)
FUNDER=
# 1 = email/Magic login, 2 = browser wallet (MetaMask etc.)
SIGNATURE_TYPE=1
